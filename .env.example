# Elysia 环境变量示例
# 用法：复制本文件为代码库根目录 .env 后按需修改（.env 已被 .gitignore 排除，绝不入库）
# 前缀：ELYSIA_（见 src/elysia/core/config.py）

# 日志级别：DEBUG / INFO / WARNING / ERROR
# ELYSIA_LOG_LEVEL=INFO

# 心跳间隔（秒）
# ELYSIA_HEARTBEAT_INTERVAL_S=1.0
# ELYSIA_BODY_HEARTBEAT_INTERVAL_S=5.0

# 路径（默认为代码库内 data/ 与 D:\ElysiaBackup\elysia）
# ELYSIA_DATA_DIR=data
# ELYSIA_LOG_DIR=data/logs
# ELYSIA_RUN_DIR=data/run
# ELYSIA_BACKUP_DIR=D:/ElysiaBackup/elysia
