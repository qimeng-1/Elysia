# Elysia 环境变量示例
# 用法：复制本文件为代码库根目录 .env 后按需修改（.env 已被 .gitignore 排除，绝不入库）
# 前缀：ELYSIA_（见 src/elysia/core/config.py）

# 日志级别：DEBUG / INFO / WARNING / ERROR
# ELYSIA_LOG_LEVEL=INFO

# 心跳间隔（秒）
# ELYSIA_HEARTBEAT_INTERVAL_S=1.0
# ELYSIA_BODY_HEARTBEAT_INTERVAL_S=5.0

# 路径（默认为代码库内 data/ 与 D:\ElysiaBackup\elysia）
# ELYSIA_DATA_DIR=data
# ELYSIA_LOG_DIR=data/logs
# ELYSIA_RUN_DIR=data/run
# ELYSIA_BACKUP_DIR=D:/ElysiaBackup/elysia

# P2 LLM —— 主声 DeepSeek（.env 填真实 key，绝不入库）
# ELYSIA_LLM_MAIN_BASE=https://api.deepseek.com
# ELYSIA_LLM_MAIN_API_KEY=
# ELYSIA_LLM_MAIN_MODEL=deepseek-chat
# ELYSIA_LLM_MAIN_TIMEOUT_S=30
# ELYSIA_LLM_FALLBACK_BASE=
# ELYSIA_LLM_FALLBACK_API_KEY=
# ELYSIA_LLM_FALLBACK_MODEL=qwen:7b
# ELYSIA_LLM_VRAM_THRESHOLD_MB=9510        # VRAM 超阈值切次声/微声
# ELYSIA_LLM_DEGRADE_SA_DELTA=2.0           # 每次降级写入感受层的 SA 增量

# P2 TTS —— GPT-SoVITS 出声（服务地址/缓存/熔断）
# ELYSIA_TTS_GPTSOVITS_URL=http://127.0.0.1:9880
# ELYSIA_TTS_CACHE_DIR=data/cache/tts
# ELYSIA_TTS_TEXT_LANG=zh
# ELYSIA_TTS_PROMPT_LANG=zh
# ELYSIA_TTS_TIMEOUT_S=60
# ELYSIA_TTS_VRAM_THRESHOLD_MB=10240         # VRAM 超阈值或队列拥塞 → 只输出文本
# ELYSIA_TTS_DEGRADE_SA_DELTA=1.0            # TTS 降级写入感受层的 SA 增量
# ELYSIA_TTS_COMMON_PHRASES=["我在","好呀","嗯嗯"]  # 低负载期预合成的高频短语
