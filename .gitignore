# ── Elysia 代码库边界 ──────────────────────────────────────────
# 定义什么进 git、什么不进（仓库边界）。

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 运行时数据（data/ 进 git 做记忆快照版本化；仅排除缓存/日志/临时）
data/logs/
data/cache/
data/tmp/
data/run/
# 运行时 SQLite 主体文件（进程持续锁定写入，改由 checkpoints/ 做快照版本化）
data/heartbeat.db
data/state.db
*.log
# SQLite WAL 模式伴生文件（随进程运行实时变化，不提交）
*.db-wal
*.db-shm

# 密钥与本地配置（绝不进仓库）
.env
*.env.local
config.local.*
api_keys.*
*.key
*.pem

# 系统文件
Thumbs.db
.DS_Store
desktop.ini

# ── 角色素材（P4b 之后新增）────────────────────────────────────
# 桌宠的服装包（抠好的序列帧）**不入库**，两条理由：
#   1. 版权：形象素材来自游戏官方美术与同人图，提交进仓库（尤其是公开仓库）风险明确
#   2. 体积：一段 4 秒动画的母版 PNG 序列就有 ~18 MB，10 段就上百 MB
# 约定与生成方式见 assets/pet/README.md；用 scripts/asset_pipeline.py 从视频生成。
assets/pet/costumes/
# 素材流水线的中间产物
assets/pet/_work/
# 撤下的素材（AI 生成 / 官方立绘）：保留在本地但不再启用
assets/pet/_retired/
